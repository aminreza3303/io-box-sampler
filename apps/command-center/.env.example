DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/command_center?schema=public"
AUTH_SESSION_SECRET="replace-with-a-long-random-secret-at-least-16-characters"
# For prisma dev, use its direct TCP URL above and its separate shadow TCP URL below.
# Never point the shadow URL at the primary database.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5433/command_center_shadow"
# Hermes uses the installed CLI by default. Set an absolute path only when it is not on PATH.
HERMES_EXECUTABLE=hermes
HERMES_PROVIDER=openrouter
HERMES_MODEL=openai/gpt-4o-mini
# OMP is optional and must point to an executable compatible with the adapter (on Windows use omp.cmd).
OMP_EXECUTABLE=
# Workspace root for projects. Leave empty to use the repository root in local development.
COMMAND_CENTER_PROJECT_ROOT=
# Optional project-specific overrides. For Docker these paths must exist inside a mounted volume.
COMMAND_CENTER_PROJECT_NEWCASH_PATH=
COMMAND_CENTER_PROJECT_SHATI_PATH=
COMMAND_CENTER_PROJECT_TARAZ_PATH=
